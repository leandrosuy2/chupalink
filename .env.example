APP_PORT=3000
APP_ENV=development
# Origens permitidas no CORS, separadas por vírgula (vazio = mesma origem apenas, * = qualquer)
CORS_ORIGINS=

# Token exigido nos endpoints administrativos (Authorization: Bearer <token>) e no Socket.IO
API_TOKEN=alterar_esta_chave

WHATSAPP_SESSION_NAME=chupalink
WHATSAPP_SESSION_PATH=./storage/sessions
# IDs dos grupos autorizados, separados por vírgula (ex: 120363000000000000@g.us)
WHATSAPP_ALLOWED_GROUPS=
# Conectar automaticamente ao iniciar (usa a sessão salva; gera QR se não houver)
WHATSAPP_AUTO_CONNECT=true
# Quantos ciclos de QR Code sem leitura antes de parar e aguardar POST /api/whatsapp/connect
WHATSAPP_QR_MAX_CYCLES=5
# Limite para enviar como vídeo (mídia). Acima disso é enviado como documento.
WHATSAPP_VIDEO_MAX_MB=100
WHATSAPP_DOCUMENT_MAX_MB=2000
# Enviar as mensagens de progresso (🔎 ⬇️ ✅) no grupo
BOT_PROGRESS_MESSAGES=true

DOWNLOAD_PATH=./storage/downloads
DOWNLOAD_MAX_SIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=300
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_MAX_ATTEMPTS=2
# Máximo de vídeos baixados de um único post (carrossel do Instagram)
DOWNLOAD_MAX_ITEMS_PER_LINK=10
# auto = converte para H.264/AAC só quando o vídeo não for compatível com o WhatsApp; never = nunca converter
VIDEO_TRANSCODE=auto

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Opcional: cookies.txt (formato Netscape) da SUA conta, para posts que exigem login
INSTAGRAM_COOKIES_FILE=
TIKTOK_COOKIES_FILE=

LOG_LEVEL=info
LOG_PATH=./storage/logs
