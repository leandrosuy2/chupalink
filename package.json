{
  "name": "chupalink-api",
  "version": "1.0.0",
  "description": "ChupaLink API \u2014 bot WhatsApp (Baileys) que baixa v\u00eddeos do Instagram e TikTok enviados em grupos",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:network": "RUN_NETWORK_TESTS=1 jest test/integration/download.network.spec.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@whiskeysockets/baileys$": "<rootDir>/test/mocks/baileys.mock.ts"
    },
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.10",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.21.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "joi": "^18.3.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.7"
  }
}